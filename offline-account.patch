+/// Sentinel stored in `refresh_token` to mark an offline (cracked/local) account.
+pub const OFFLINE_ACCOUNT_MARKER: &str = "offline-account";
+
 impl Credentials {
+    /// Whether these credentials belong to an offline account.
+    pub fn is_offline_account(&self) -> bool {
+        self.refresh_token == OFFLINE_ACCOUNT_MARKER
+    }
+
+    /// Computes the deterministic UUID vanilla servers use for offline players
+    /// (`UUID.nameUUIDFromBytes("OfflinePlayer:<name>")`, i.e. MD5 based, version 3).
+    pub fn offline_uuid(username: &str) -> Uuid {
+        let mut hash: [u8; 16] =
+            md5::compute(format!("OfflinePlayer:{username}")).0;
+        hash[6] = (hash[6] & 0x0f) | 0x30;
+        hash[8] = (hash[8] & 0x3f) | 0x80;
+        Uuid::from_bytes(hash)
+    }
+
+    /// Validates an offline username (Minecraft rules: 3-16 chars of [A-Za-z0-9_]).
+    pub fn validate_offline_username(username: &str) -> bool {
+        (3..=16).contains(&username.len())
+            && username
+                .chars()
+                .all(|c| c.is_ascii_alphanumeric() || c == '_')
+    }
+
+    /// Creates a new offline account and stores it as the active account.
+    pub async fn create_offline(
+        username: &str,
+        exec: impl sqlx::Executor<'_, Database = sqlx::Sqlite> + Copy,
+    ) -> crate::Result<Self> {
+        let username = username.trim();
+        if !Self::validate_offline_username(username) {
+            return Err(crate::ErrorKind::OtherError(
+                "Offline username must be 3-16 characters: letters, numbers or underscore".to_string(),
+            )
+            .as_error());
+        }
+
+        let credentials = Self {
+            offline_profile: MinecraftProfile {
+                id: Self::offline_uuid(username),
+                name: username.to_string(),
+                ..MinecraftProfile::default()
+            },
+            access_token: "0".to_string(),
+            refresh_token: OFFLINE_ACCOUNT_MARKER.to_string(),
+            // Far-future expiry so the Microsoft refresh flow is never attempted.
+            expires: Utc.with_ymd_and_hms(2100, 1, 1, 0, 0, 0).unwrap(),
+            active: true,
+        };
+        credentials.upsert(exec).await?;
+        Ok(credentials)
+    }
