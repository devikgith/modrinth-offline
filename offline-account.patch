@@ -0,0 +1,158 @@
+<template>
+	<NewModal ref="modal" header="Minecraft accounts" max-width="480px">
+		<div class="flex flex-col gap-3 w-[420px] max-w-full">
+			<p v-if="accounts.length === 0" class="m-0 text-secondary">
+				No accounts yet. Add an offline account below.
+			</p>
+			<div
+				v-for="account in accounts"
+				:key="account.profile.id"
+				class="flex items-center gap-3 rounded-xl border border-solid p-3"
+				:class="isActive(account) ? 'border-brand' : 'border-surface-4'"
+			>
+				<div
+					class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-button-bg font-semibold text-contrast"
+				>
+					{{ initial(account) }}
+				</div>
+				<div class="min-w-0 flex-1 truncate font-medium text-contrast">
+					{{ account.profile.name }}
+				</div>
+				<span v-if="isActive(account)" class="text-sm font-semibold text-brand">Active</span>
+				<Button v-else :disabled="busy" @click="switchTo(account)">Switch</Button>
+				<IconButton type="quiet" label="Remove account" :disabled="busy" @click="removeAccount(account)">
+					<XIcon />
+				</IconButton>
+			</div>
+
+			<div class="mt-2 flex flex-col gap-2">
+				<span class="text-sm text-secondary">New offline account</span>
+				<div class="flex gap-2">
+					<input
+						v-model="newName"
+						type="text"
+						maxlength="16"
+						autocomplete="off"
+						placeholder="Username (3-16 chars)"
+						class="flex-1"
+						@input="error = ''"
+						@keyup.enter="addAccount"
+					/>
+					<Button type="colored" color="brand" :disabled="!nameValid || busy" @click="addAccount">
+						<SpinnerIcon v-if="busy" class="animate-spin" />
+						<PlusIcon v-else />
+						Add
+					</Button>
+				</div>
+				<p v-if="error" class="m-0 text-sm text-red">{{ error }}</p>
+				<p class="m-0 text-xs text-secondary">
+					Letters, numbers and underscore only. Offline accounts work in singleplayer and on
+					offline-mode servers.
+				</p>
+			</div>
+		</div>
+	</NewModal>
+</template>
+
+<script setup>
+import { PlusIcon, SpinnerIcon, XIcon } from '@modrinth/assets'
+import { Button, IconButton, NewModal } from '@modrinth/ui'
+import { computed, inject, ref } from 'vue'
+
+import { handleSevereError } from '@/composables/use-error.js'
+import {
+	get_default_user,
+	login_offline,
+	remove_user,
+	set_default_user,
+	users,
+} from '@/helpers/auth.js'
+
+const accountsCard = inject('accountsCard', null)
+
+const modal = ref()
+const accounts = ref([])
+const activeId = ref(null)
+const newName = ref('')
+const error = ref('')
+const busy = ref(false)
+
+const nameValid = computed(() => /^[A-Za-z0-9_]{3,16}$/.test(newName.value.trim()))
+
+function isActive(account) {
+	return account.profile.id === activeId.value
+}
+
+function initial(account) {
+	return (account.profile.name?.[0] ?? '?').toUpperCase()
+}
+
+async function refresh() {
+	try {
+		const list = (await users()) ?? []
+		let current = (await get_default_user()) ?? null
+
+		if (list.length > 0 && !list.some((account) => account.profile.id === current)) {
+			current = list[0].profile.id
+			await set_default_user(current)
+		}
+
+		accounts.value = list
+		activeId.value = current
+		await accountsCard?.value?.refreshValues?.()
+	} catch (e) {
+		handleSevereError(e)
+	}
+}
+
+async function show() {
+	await refresh()
+	modal.value?.show()
+}
+
+async function switchTo(account) {
+	busy.value = true
+	try {
+		await set_default_user(account.profile.id)
+		await refresh()
+	} catch (e) {
+		handleSevereError(e)
+	} finally {
+		busy.value = false
+	}
+}
+
+async function removeAccount(account) {
+	busy.value = true
+	try {
+		await remove_user(account.profile.id)
+		await refresh()
+	} catch (e) {
+		handleSevereError(e)
+	} finally {
+		busy.value = false
+	}
+}
+
+async function addAccount() {
+	if (!nameValid.value || busy.value) return
+	busy.value = true
+	error.value = ''
+	try {
+		const created = await login_offline(newName.value.trim())
+		if (created) {
+			await set_default_user(created.profile.id)
+			newName.value = ''
+		}
+		await refresh()
+	} catch (e) {
+		error.value = String(e?.message ?? e)
+	} finally {
+		busy.value = false
+	}
+}
+
+defineExpose({
+	show,
+})
+</script>
